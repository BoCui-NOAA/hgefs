#!/bin/bash
#PBS -N hgefs_ensstat
#PBS -j oe                  
#PBS -q pridev  
#PBS -l walltime=01:00:00
#PBS -A GFS-DEV                
#PBS -l select=1:ncpus=41:mpiprocs=41:mem=150GB
#PBS -l debug=true

model=hgefs

## HOMEhgefs will de defined by the eclfow apps

export HOMEhgefs=/lfs/h2/emc/vpppg/noscrub/bo.cui/hgefs.v1.0.0
source ${HOMEhgefs}/versions/run.ver

cd $PBS_O_WORKDIR

set -x

module purge

module load envvar/${envvar_ver}
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load prod_envir/${prod_envir_ver}
module load prod_util/${prod_util_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load wgrib2/${wgrib2_ver}
module load iobuf/${iobuf_ver}
module load craype-hugepages2M
module list

##

export PDY=20250914
export cyc=00
export job=hgefs_ensstat_$PDY$cyc
export envir=para

# EXPORT list here

export export OMP_NUM_THREADS=1
export APRUN="mpiexec -np 41 --cpu-bind core cfp "         
export IOBUF_PARAMS='*:sync,%%stdout:sync'

export DATAROOT=/lfs/h2/emc/ptmp/$LOGNAME/tmpnwprd 

export COMIN_GEFS=/lfs/h1/ops/prod/com/gefs/v12.3/gefs.$PDY/$cyc/atmos
export COMIN_AIGEFS=/lfs/h1/ops/para/com/aigefs/v1.0/aigefs.$PDY/$cyc/model/atmos
export COMOUT=/lfs/h2/emc/ptmp/$LOGNAME/com/hgefs/v1.0/hgefs.$PDY/${cyc}/atmos/products/ensstat

export KEEPDATA=YES

# CALL executable job script here
${HOMEhgefs}/jobs/JHGEFS_ENSSTAT

